rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function dono() { return logado() && request.auth.token.owner == true; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function temAcesso() {
      return dono() || (logado()
        && exists(/databases/$(database)/documents/acessos/$(request.auth.uid))
        && get(/databases/$(database)/documents/acessos/$(request.auth.uid)).data.status == 'aceito');
    }

    // Dados pessoais: perfil, log, rascunho, social, chaves, modelos. Só o próprio uid.
    match /data/users/{uid}/{resto=**} {
      allow read, write: if eu(uid);
    }

    // Acesso e revisão: cada pessoa mexe no próprio documento, o dono em todos.
    match /acessos/{id}  { allow read, write: if dono() || eu(id); }
    match /pedidos/{id}  { allow read, write: if dono() || eu(id); }
    match /revisao/{id}  { allow read, write: if dono() || eu(id); }
    match /resumo/{id}   { allow read, write: if dono() || eu(id); }
    match /aprovados/{id} {
      allow read: if dono() || eu(id);
      allow write: if dono();
    }

    // Grupos: só números da semana e apelido. Lê quem tem acesso, grava o próprio documento.
    match /grupos/{id} {
      allow read: if temAcesso();
      allow write: if dono() || (temAcesso() && eu(id));
    }

    // Personal e Nutri. O conteúdo sensível é cifrado no navegador (ver README, "Limites da cifragem").
    match /papeis/{id}   { allow read: if logado(); allow write: if dono() || eu(id); }
    match /convites/{id} { allow read, write: if logado(); }
    match /vinculos/{id} { allow read, write: if logado(); }
    match /snap/{id}     { allow read, write: if logado(); }
    match /prop/{id}     { allow read, write: if logado(); }
    match /inbox/{uid}/n/{id} { allow read, write: if logado(); }

    // Configuração do dono e posts públicos do dono.
    match /config/{id} { allow read: if logado(); allow write: if dono(); }
    match /posts/{id}  { allow read: if logado(); allow write: if dono(); }

    // Nome, foto e resumo públicos (para o feed), gravados pelo próprio uid. Lê quem tem acesso ao app.
    match /perfis/{id} { allow read: if temAcesso() || eu(id); allow write: if eu(id); }

    // Feed compartilhado: todo mundo com acesso vê todos os posts.
    // O autor cria, edita e apaga o próprio post; qualquer pessoa com acesso só dá fogo (na própria chave) e comenta (um por vez, em nome próprio).
    function feedChaves() { return ['autor','nome','avatar','date','at','esporte','outro','titulo','stats','legenda','foto','plano','junto','selo','fogos','coments']; }
    function antesFogos() { return resource.data.get('fogos', {}); }
    function depoisFogos() { return request.resource.data.get('fogos', {}); }
    function antesComents() { return resource.data.get('coments', []); }
    function depoisComents() { return request.resource.data.get('coments', []); }
    function fogoOk() { return depoisFogos().diff(antesFogos()).affectedKeys().hasOnly([request.auth.uid]); }
    function comentOk() {
      return depoisComents() == antesComents()
        || (depoisComents().size() == antesComents().size() + 1
            && depoisComents().size() <= 200
            && depoisComents()[0:antesComents().size()] == antesComents()
            && depoisComents()[antesComents().size()].de == request.auth.uid
            && depoisComents()[antesComents().size()].t is string
            && depoisComents()[antesComents().size()].t.size() <= 120);
    }
    match /feedposts/{id} {
      allow read: if temAcesso();
      allow create: if temAcesso()
        && request.resource.data.autor == request.auth.uid
        && request.resource.data.keys().hasOnly(feedChaves())
        && request.resource.data.get('foto', '').size() <= 300000;
      allow update: if temAcesso() && (
        (resource.data.autor == request.auth.uid
          && request.resource.data.autor == resource.data.autor
          && request.resource.data.keys().hasOnly(feedChaves())
          && request.resource.data.get('foto', '').size() <= 300000)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fogos', 'coments']) && fogoOk() && comentOk()));
      allow delete: if dono() || (logado() && resource.data.autor == request.auth.uid);
    }

    // Contador diário da IA: só a Cloud Function (Admin SDK ignora as regras).
    match /uso/{id} { allow read, write: if false; }
  }
}
