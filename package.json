{
  "name": "tropa",
  "private": true,
  "description": "Tropa fora do claude.ai: build da PWA, shim do Firebase, endpoint da IA (Vercel) e testes",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules/*.test.js\"",
    "build:www": "node app/scripts/build-www.js",
    "icones": "node app/scripts/gerar-icones.js"
  },
  "dependencies": {
    "firebase": "^10.14.1",
    "firebase-admin": "^14.5.0",
    "@anthropic-ai/sdk": "^1.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "esbuild": "^0.24.0",
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": "22.x"
  }
}
